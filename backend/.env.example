# انسخ هذا الملف إلى .env للتطوير المحلي. في الاستضافة ضع هذه القيم في إعدادات Environment.

PORT=5000
NODE_ENV=development

# محلياً: 127.0.0.1 وليس localhost (Node الحديث قد يحوّل localhost إلى ::1 فيفشل الاتصال)
# في الإنتاج: رابط MongoDB Atlas، مثل mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mosque-app
MONGODB_URI=mongodb://127.0.0.1:27017/mosque-app

# سرّ عشوائي طويل. ولّده بهذا الأمر ولا تعيد استعمال سرّ التطوير في الإنتاج:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ضع-هنا-قيمة-مولّدة

# حد محاولات الدخول/التسجيل لكل IP كل 15 دقيقة. 200 للتطوير، 20 في الإنتاج
AUTH_RATE_LIMIT=200

# اختياري (إنتاج فقط): نطاقات يُسمح لها باستدعاء الـ API من موقع آخر، مفصولة بفاصلة.
# اتركه فارغاً إن كانت الواجهة تُقدَّم من نفس السيرفر.
# CORS_ORIGIN=https://example.com
